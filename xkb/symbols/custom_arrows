default partial alphanumeric_keys modifier_keys
xkb_symbols "arrows" {
    include "us(basic)"
    name[Group1] = "English (US, 60% arrow cluster)";

    // Right Shift -> Up Arrow
    key <RTSH> { type[Group1] = "ONE_LEVEL", symbols[Group1] = [ Up ] };

    // Menu / Application ("little button with cursor over form") -> Down Arrow
    key <COMP> { type[Group1] = "ONE_LEVEL", symbols[Group1] = [ Down ] };

    // Print Screen (PrtSc on ThinkPad) -> Down Arrow
    key <PRSC> { type[Group1] = "ONE_LEVEL", symbols[Group1] = [ Down ] };

    // Right Control -> Right Arrow
    key <RCTL> { type[Group1] = "ONE_LEVEL", symbols[Group1] = [ Right ] };

    // Right Alt -> Left Arrow
    key <RALT> { type[Group1] = "ONE_LEVEL", symbols[Group1] = [ Left ] };

    // Fn scancode (if emitted by keyboard) -> Left Arrow
    key <I472> { type[Group1] = "ONE_LEVEL", symbols[Group1] = [ Left ] };

    // Right Win / Super -> Left Arrow (fallback for 60% boards where Fn/Win sends RWIN)
    key <RWIN> { type[Group1] = "ONE_LEVEL", symbols[Group1] = [ Left ] };

    modifier_map Shift { <LFSH> };
    modifier_map Control { <LCTL> };
    modifier_map Mod1 { <LALT> };
    modifier_map Mod4 { <LWIN>, <SUPR> };
};
