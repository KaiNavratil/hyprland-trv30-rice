#!/usr/bin/env python3
"""
Transparent backward-compatibility wrapper for hyprctl on Hyprland 0.57+ (Lua).
Translates legacy CLI arguments (such as keyword, dispatch, --batch) into native
Hyprland 0.57 Lua dispatchers and evaluation calls.
"""
import sys
import subprocess
import json
import shlex

HYPRCTL_BIN = "/usr/bin/hyprctl"

def parse_lua_val(val_str):
    v_lower = val_str.lower().strip()
    if v_lower in ("true", "yes"):
        return "true"
    if v_lower in ("false", "no"):
        return "false"
    try:
        if "." in val_str:
            float(val_str)
            return val_str
        int(val_str)
        return val_str
    except ValueError:
        pass
    return json.dumps(val_str)

def translate_dispatch(subargs):
    if not subargs:
        return ["dispatch"]
    d_cmd = subargs[0]
    rest = subargs[1:]

    # Already native Lua dispatcher
    if d_cmd.startswith("hl.") or "(" in d_cmd:
        return ["dispatch", " ".join(subargs)]

    if d_cmd == "togglespecialworkspace":
        ws = rest[0] if rest else ""
        return ["dispatch", f'hl.dsp.workspace.toggle_special("{ws}")']

    if d_cmd == "workspace":
        ws = rest[0] if rest else "1"
        return ["dispatch", f'hl.dsp.focus({{ workspace = "{ws}" }})']

    if d_cmd == "focusmonitor":
        mon = rest[0] if rest else "+1"
        return ["dispatch", f'hl.dsp.focus({{ monitor = "{mon}" }})']

    if d_cmd == "focuswindow":
        win = rest[0] if rest else ""
        if win.startswith("0x"):
            win = f"address:{win}"
        return ["dispatch", f'hl.dsp.focus({{ window = "{win}" }})']

    if d_cmd == "killactive":
        return ["dispatch", "hl.dsp.window.kill()"]

    if d_cmd == "fullscreen":
        return ["dispatch", "hl.dsp.window.fullscreen()"]

    if d_cmd == "togglefloating":
        win = rest[0] if rest else None
        if win:
            if win.startswith("0x"):
                win = f"address:{win}"
            return ["dispatch", f'hl.dsp.window.float({{ action = "toggle", window = "{win}" }})']
        return ["dispatch", 'hl.dsp.window.float({ action = "toggle" })']

    if d_cmd == "settiled":
        win = rest[0] if rest else None
        if win:
            if win.startswith("0x"):
                win = f"address:{win}"
            return ["dispatch", f'hl.dsp.window.float({{ action = "disable", window = "{win}" }})']
        return ["dispatch", 'hl.dsp.window.float({ action = "disable" })']

    if d_cmd == "pin":
        win = rest[0] if rest else None
        if win and win != "active":
            if win.startswith("0x"):
                win = f"address:{win}"
            return ["dispatch", f'hl.dsp.window.pin({{ window = "{win}" }})']
        return ["dispatch", 'hl.dsp.window.pin()']

    if d_cmd == "dpms":
        state = rest[0] if rest else "toggle"
        return ["dispatch", f'hl.dsp.dpms("{state}")']

    if d_cmd == "moveworkspacetomonitor" and len(rest) >= 2:
        ws, mon = rest[0], rest[1]
        return ["dispatch", f'hl.dsp.workspace.move({{ workspace = "{ws}", monitor = "{mon}" }})']

    if d_cmd in ("movetoworkspace", "movetoworkspacesilent"):
        s_flag = "true" if d_cmd == "movetoworkspacesilent" else "false"
        ws_arg = rest[0] if rest else "1"
        parts = ws_arg.split(",", 1)
        ws_target = parts[0]
        win = parts[1].strip() if len(parts) > 1 else (rest[1].strip() if len(rest) > 1 else None)
        if win:
            if win.startswith("0x"):
                win = f"address:{win}"
            return ["dispatch", f'hl.dsp.window.move({{ workspace = "{ws_target}", window = "{win}", silent = {s_flag} }})']
        else:
            return ["dispatch", f'hl.dsp.window.move({{ workspace = "{ws_target}", silent = {s_flag} }})']

    if d_cmd == "exec":
        exec_str = " ".join(rest)
        lua_str = json.dumps(exec_str)
        return ["dispatch", f'hl.dsp.exec_raw({lua_str})']

    return ["dispatch"] + subargs

def translate_keyword(subargs):
    if not subargs:
        return ["keyword"]
    key = subargs[0]
    val = " ".join(subargs[1:]) if len(subargs) > 1 else ""

    if key == "monitor":
        parts = [p.strip() for p in val.split(",")]
        out_name = parts[0]
        if len(parts) > 1 and parts[1] == "disable":
            return ["eval", f'hl.monitor({{ output = "{out_name}", disabled = true }})']
        else:
            mode = parts[1] if len(parts) > 1 else "preferred"
            pos = parts[2] if len(parts) > 2 else "auto"
            scale = parts[3] if len(parts) > 3 else "1.0"
            mirror_part = ""
            for p in parts[4:]:
                if p.startswith("mirror,") or p.startswith("mirror:"):
                    m_out = p.split(",", 1)[1] if "," in p else p.split(":", 1)[1]
                    mirror_part = f', mirror = "{m_out}"'
            return ["eval", f'hl.monitor({{ output = "{out_name}", mode = "{mode}", position = "{pos}", scale = {scale}{mirror_part}, disabled = false }})']

    if key == "workspace":
        parts = [p.strip() for p in val.split(",")]
        ws_name = parts[0]
        opts = []
        if ws_name.isdigit():
            opts.append(f"workspace = {int(ws_name)}")
        else:
            opts.append(f'workspace = "{ws_name}"')
        for p in parts[1:]:
            if ":" in p:
                k, v = [x.strip() for x in p.split(":", 1)]
                if k == "persistent":
                    p_val = "true" if v.lower() in ("true", "1") else "false"
                    opts.append(f"persistent = {p_val}")
                elif k == "monitor":
                    opts.append(f'monitor = "{v}"')
                elif k in ("gapsout", "gaps_out"):
                    opts.append(f"gaps_out = {v}")
                elif k in ("gapsin", "gaps_in"):
                    opts.append(f"gaps_in = {v}")
                elif k in ("border", "bordersize"):
                    if v.lower() in ("false", "0"):
                        opts.append("no_border = true")
        opt_str = ", ".join(opts)
        return ["eval", f"hl.workspace_rule({{ {opt_str} }})"]

    if ":" in key:
        raw_parts = key.split(":")
        # Normalize dashes to underscores for options (e.g. tap-to-click -> tap_to_click)
        parts = [p.replace("-", "_") if not p.startswith("col.") else p for p in raw_parts]
        v_lua = parse_lua_val(val)
        res = f'["{parts[-1]}"] = {v_lua}'
        for p in reversed(parts[:-1]):
            res = f'["{p}"] = {{ {res} }}'
        return ["eval", f"hl.config({{ {res} }})"]

    return ["keyword"] + subargs

def translate_single_command(tokens):
    if not tokens:
        return []
    cmd = tokens[0]
    subargs = tokens[1:]

    if cmd == "dispatch":
        return translate_dispatch(subargs)
    elif cmd == "keyword":
        return translate_keyword(subargs)
    return tokens

def handle_batch(args):
    batch_str = " ".join([a for a in args if a != "--batch"])
    subcmds = [s.strip() for s in batch_str.split(";") if s.strip()]
    translated_cmds = []

    for sc in subcmds:
        try:
            tokens = shlex.split(sc)
        except Exception:
            tokens = sc.split()
        trans = translate_single_command(tokens)
        if trans:
            translated_cmds.append(" ".join(trans))

    if not translated_cmds:
        return 0

    batch_payload = " ; ".join(translated_cmds)
    return subprocess.call([HYPRCTL_BIN, "--batch", batch_payload])

def main():
    args = sys.argv[1:]
    if not args:
        sys.exit(subprocess.call([HYPRCTL_BIN]))

    if "--batch" in args:
        sys.exit(handle_batch(args))

    cmd = args[0]
    subargs = args[1:]

    if cmd == "dispatch":
        trans = translate_dispatch(subargs)
        sys.exit(subprocess.call([HYPRCTL_BIN] + trans))

    if cmd == "keyword":
        trans = translate_keyword(subargs)
        sys.exit(subprocess.call([HYPRCTL_BIN] + trans))

    sys.exit(subprocess.call([HYPRCTL_BIN] + args))

if __name__ == "__main__":
    main()
